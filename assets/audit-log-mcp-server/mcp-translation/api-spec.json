  ],
  "schemes": [
    "https",
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v2/auditlogrecords": {
      "get": {
        "tags": [
          "AuditlogRetrievalAPI"
        ],
        "summary": "Finds all audit log records for your tenant.",
        "description": "Multiple filter values can be provided.",
        "operationId": "getAllAuditlogs",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "time_from",
            "description": "Start date of the search. By default: 30 days ago.",
            "required": false,
            "type": "string"
          },
          {
            "in": "query",
            "name": "time_to",
            "description": "End date of the search. By default: now.",
            "required": false,
            "type": "string"
          },
          {
            "in": "query",
            "name": "handle",
            "description": "The value from the response header 'Paging' of the previous log retrieval.",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation.",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "message_uuid": {
                    "type": "string",
                    "description": "Audit log message GUID unique identifier."
                  },
                  "time": {
                    "type": "string",
                    "description": "Audit log creation time."
                  },
                  "tenant": {
                    "type": "string",
                    "description": "Auditlog tenant value."
                  },
                  "org_id": {
                    "type": "string",
                    "description": "Audit log org id."
                  },
                  "space_id": {
                    "type": "string",
                    "description": "Audit log space id."
                  },
                  "app_or_service_id": {
                    "type": "string",
                    "description": "Audit log application or service id."
                  },
                  "als_service_id": {
                    "type": "string",
                    "description": "Audit log als service id."
                  },
                  "user": {
                    "type": "string",
                    "description": "Audit log user."
                  },
                  "category": {
                    "type": "string",
                    "description": "Audit log category."
                  },
                  "format_version": {
                    "type": "string",
                    "description": "Audit log format version."
                  },
                  "message": {
                    "type": "string",
                    "description": "Audit log message."
                  }
                }
              }
            }
          },
          "204": {
            "description": "No data available.",
            "schema": {
              "$ref": "#/definitions/NoContent"
            }
          },
          "400": {
            "description": "Wrong request parameters.",
            "schema": {
              "$ref": "#/definitions/BadRequest"
            }
          },
          "401": {
            "description": "Missing or invalid authentication token.",
            "schema": {
              "$ref": "#/definitions/Unauthorized"
            }
          },
          "403": {
            "description": "Insufficient permissions.",
            "schema": {
              "$ref": "#/definitions/Forbidden"
            }
          },
          "429": {
            "description": "Rate Limit exceeded",
            "schema": {
              "$ref": "#/definitions/RateLimited"
            }
          },
          "500": {
            "description": "Internal server error.",
            "schema": {
              "$ref": "#/definitions/InternalServerError"
            }
          }
        }
      }
    }
  },
