{
  "swagger": "2.0",
  "info": {
    "title": "Audit Log Retrieval API (Cloud Foundry environment)",
    "description": "The audit log retrieval API V2 provides functionality for retrieving audit logs. The extraction of the audit logs is strictly limited to the records possessed by a tenant that is extracted from the XSUAA. The API supports server-side pagination with 5000 events per page. If the size of events is bigger than the server page size, the results are returned by the server on pages, providing the response header 'Paging' with the next page. The audit log retrieval API supports filtering the results based on time. If no time based filtering is specified, the results for the last 30 days are returned.",
    "version": "2.0.0"
  },
  "x-sap-shortText": "Provides functionality to retrieve audit logs.",
  "externalDocs": {
    "description": "Audit Log Retrieval API V2 (Cloud Foundry environment)",
    "url": "https://help.sap.com/viewer/65de2977205c403bbc107264b8eccf4b/Cloud/en-US/30ece35bac024ca69de8b16bff79c413.html"
  },
  "securityDefinitions": {
    "OAuth2": {
      "type": "oauth2",
      "description": "To use this REST API, you need to get OAuth client credentials (for mTLS certificates and private key and for non-mTLS clientID and secret). To obtain an access_token, look at the documentation(https://help.sap.com/viewer/65de2977205c403bbc107264b8eccf4b/Cloud/en-US/30ece35bac024ca69de8b16bff79c413.html)",
      "flow": "application",
      "tokenUrl": "https://{tokenUrl}/oauth/token",
      "scopes": {
        "hcp.readAuditLogs": "read audit logs"
      }
    }
  },
  "security": [
    {
      "OAuth2": [
        "hcp.readAuditLogs"
      ]
    }
  ],
  "x-servers": [
    {
      "url": "https://auditlog-management.cfapps.{host}/auditlog",
      "description": "Audit Log Retrieval API endpoint",
      "templates": {
        "host": {
          "description": "SAP Business Technology Platform Data Center host",
          "enum": [
            "us10.hana.ondemand.com",
            "ap12.hana.ondemand.com",
            "eu11.hana.ondemand.com",
            "ap10.hana.ondemand.com",
            "ap11.hana.ondemand.com",
            "br10.hana.ondemand.com",
            "ca10.hana.ondemand.com",
            "jp10.hana.ondemand.com",
            "eu10.hana.ondemand.com",
            "eu20.hana.ondemand.com",
            "us20.hana.ondenand.com",
            "jp20.hana.ondemand.com",
            "us21.hana.ondemand.com",
            "ap21.hana.ondemand.com",
            "us30.hana.ondemand.com",
            "in30.hana.ondemand.com"
