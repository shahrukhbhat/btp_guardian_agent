            "openApiType": {
                "path": "/accounts/{subaccountName}/apps/{appName}/processes/{processId}/metrics",
                "method": "get",
                "operationId": "GET_subaccount_app_process_metrics",
                "parameters": [
                    {
                        "name": "subaccountName",
